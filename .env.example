# Contract for every environment variable Fit reads. See docs/adr/0002-secrets-handling.md.
# Local: copy to .env.local at the repo root (used by docker compose). Never commit .env.local.
# Vercel / production: set the same names per environment (Preview and Production get their own keys).

# ── Public (inlined into the browser bundle) ───────────────────────────────
# Public origin of the web app (for testing inside Telegram: the HTTPS tunnel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://zxwabddqqtitybtsdeqp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_soAtBujNYOIUTOR60-p8EQ_Pf2FL8H4
# Optional: Sentry DSN of the web project (ADR 0017). Empty: error reporting is off, nothing is sent anywhere.
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-only: web ───────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=
# @BotFather → bot → Login Widget (Telegram Login, OpenID Connect)
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Optional: max age of Mini App initData that may start a new session, seconds (default 3600)
# TELEGRAM_INIT_DATA_MAX_AGE=3600
# Bearer secret of POST /api/cron/notifications, 32-256 chars [A-Za-z0-9_-] (openssl rand -hex 32). Supabase keeps
# the same value in Vault: private.configure_notification_dispatch (ADR 0006). Empty: the route answers 503.
CRON_SECRET=
# Optional: username of the bot (without @) whose Mini App opens invite links; default fitconnection_bot.
# Locally: your own dev bot.
TELEGRAM_BOT_USERNAME=
# Optional: Telegram group id (negative) that gets the team messages, e.g. new verification requests
TELEGRAM_ADMIN_CHAT_ID=
# Optional: GitHub fine-grained token with "Issues: read and write" on the feedback repository. The feedback button
# files an issue with it (PRD FDBK-1) only when GITHUB_FEEDBACK_REPO is set too; otherwise no issue is filed and the
# message still reaches /admin/feedback.
GITHUB_FEEDBACK_TOKEN=
# Optional: owner/name of a PRIVATE repository for those issues. No default: feedback text is personal, and an issue
# in a public repository is visible to everyone.
GITHUB_FEEDBACK_REPO=
# Optional: the operator's details printed in the legal documents and consents (152-FZ asks for the operator's
# name and address in a consent). Set them in Vercel only, never in the repository: it is public. Unset ones stay
# as placeholders such as [ФИО ОПЕРАТОРА] in the text.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=

# ── Server-only: shared by web (initData check) and bot ────────────────────
# Bot token from @BotFather. Production: @fitconnection_bot (Vercel dafit-web and dafit-bot Production, GitHub
# repository secret for the "Bot setup" workflow). Locally: your own dev bot (ADR 0002 §5); local polling refuses
# @fitconnection_bot and any bot that has a webhook. Previews of dafit-bot get no Telegram variables.
TELEGRAM_BOT_TOKEN=

# ── Bot ────────────────────────────────────────────────────────────────────
# Public: HTTPS URL the bot's buttons open as the Mini App (Telegram requires https; locally the tunnel URL)
WEBAPP_URL=
# Public, Docker only: polling (docker-compose.yml) | webhook (docker-compose.prod.yml). Vercel does not read it.
BOT_MODE=polling
# Public, Docker webhook mode and python -m fit_bot setup: origin Telegram calls, e.g. https://bot.example.com
# (the "Bot setup" workflow sets it to the dafit-bot domain itself)
BOT_WEBHOOK_URL=
# Public, Docker webhook mode only: port of the bot's HTTP server (default 8080)
# PORT=8080
# Server-only, optional: 16-256 chars [A-Za-z0-9_-]. Empty means it is derived from TELEGRAM_BOT_TOKEN.
# If you set it, set it everywhere the token is (Vercel dafit-bot, GitHub repository secret) or nowhere.
TELEGRAM_WEBHOOK_SECRET=
# Set by Vercel, read by GET /healthz: VERCEL_GIT_COMMIT_SHA, VERCEL_ENV
# Set by GitHub Actions, read by python -m fit_bot setup: GITHUB_ACTIONS
