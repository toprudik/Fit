# Contract for every environment variable Fit reads. See docs/adr/0002-secrets-handling.md.
# Local: copy to .env.local at the repo root (used by docker compose). Never commit .env.local.
# Vercel / production: set the same names per environment (Preview and Production get their own keys).

# ── Public (inlined into the browser bundle) ───────────────────────────────
# Public origin of the web app (for testing inside Telegram: the HTTPS tunnel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://zxwabddqqtitybtsdeqp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_soAtBujNYOIUTOR60-p8EQ_Pf2FL8H4

# ── Server-only: web ───────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=
# @BotFather → bot → Login Widget (Telegram Login, OpenID Connect)
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Optional: max age of Mini App initData accepted for sign-in, seconds (default 3600)
# TELEGRAM_INIT_DATA_MAX_AGE=3600

# ── Server-only: shared by web (initData check) and bot ────────────────────
# @fitconnection_bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ── Bot ────────────────────────────────────────────────────────────────────
# HTTPS URL the bot opens as the Mini App (Telegram requires https; locally use the tunnel URL)
WEBAPP_URL=
# polling (local) | webhook (production)
BOT_MODE=polling
# Webhook mode only: public base URL of the bot service, e.g. https://bot.example.com
BOT_WEBHOOK_URL=
# Webhook mode only: random 16-256 chars [A-Za-z0-9_-]; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
